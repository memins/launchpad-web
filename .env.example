# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LaunchPad Web
# Homepage "Buy" CTA. Use your Gumroad product URL (kit listing, or your own product after you rebrand).
# Falls back to https://gumroad.com when unset.
NEXT_PUBLIC_GUMROAD_URL=https://gumroad.com/l/your-product

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — Developers → API keys (test mode first)
# Hosted Checkout + webhook need the secret key, price id, and webhook secret.
# The publishable key is optional until you embed Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Recurring price → subscription Checkout. One-time price → payment Checkout.
STRIPE_PRICE_ID=price_your_price_id

# Resend — transactional email
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=LaunchPad Web <noreply@yourdomain.com>
